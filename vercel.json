{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "services": {
    "zk-backend": {
      "root": "zk-backend",
      "framework": "express",
      "installCommand": "npm install --omit=dev",
      "functions": {
        "**/*.js": {
          "includeFiles": "*.json",
          "maxDuration": 60
        }
      }
    },
    "zk-frontend": {
      "root": "zk-frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "zk-backend" } },
    { "source": "/(.*)", "destination": { "service": "zk-frontend" } }
  ]
}
